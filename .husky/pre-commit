echo "🎨 Running Laravel Pint..."

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep "\.php$") || true
for FILE in $STAGED_FILES; do
    ./vendor/bin/pint "$FILE" > /dev/null 2>&1
    git add "$FILE"
done

echo "🧪 Running tests..."
php artisan test --parallel || { echo "❌ Testes falharam. Corrija antes de commitar."; exit 1; }

echo "🔍 Running Larastan..."
./vendor/bin/phpstan analyse --memory-limit=512M || { echo "❌ Larastan encontrou erros. Corrija antes de commitar."; exit 1; }

echo "✅ Tudo certo!"